# Brevo Transactional Email API key. Never commit the real value.
BREVO_API_KEY=xkeysib-your-api-key

# This sender must be verified in Brevo.
BREVO_SENDER_EMAIL=no-reply@partokens.com
BREVO_SENDER_NAME=Partokens

# The listener is published to loopback by default.
SMTP_PROXY_BIND_ADDRESS=127.0.0.1
SMTP_PROXY_HOST_PORT=2525

# Only SMTP envelope senders from these domains are accepted. Use * only on a
# trusted private network.
SMTP_ALLOWED_SENDER_DOMAINS=partokens.com
SMTP_MAX_RECIPIENTS=1
SMTP_MAX_MESSAGE_BYTES=1048576

# Reset links are accepted only for these exact hosts. Add the staging host in
# staging deployments. Use * only on a trusted private network.
PASSWORD_RESET_ALLOWED_HOSTS=partokens.com
QUOTA_WARNING_ALLOWED_HOSTS=partokens.com

# The code must remain in the subject so it is visible before opening the email.
EMAIL_SUBJECT_TEMPLATE={code} is your Partokens verification code

BREVO_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
