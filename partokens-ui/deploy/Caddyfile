# This container serves only the Partokens SPA over the internal HTTP listener.
# The explicit http:// scheme is intentional: it disables Caddy automatic HTTPS
# and its HTTP-to-HTTPS redirect. API and unprefixed administrator routes are
# forwarded to the separately operated PARTOKENS_API_ORIGIN.
{$PARTOKENS_SITE_ADDRESS} {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		X-Robots-Tag "{$PARTOKENS_ROBOTS_HEADER:all}"
		-Server
	}

	@uiHealth path /_ui/healthz
	handle @uiHealth {
		header Cache-Control "no-store"
		respond 204
	}

	@backend path /api/* /v1/* /v1beta/* /pg/* /mj/* /*/mj/* /suno/* /kling/* /jimeng /jimeng/* /dashboard/billing/*
	handle @backend {
		reverse_proxy {$PARTOKENS_API_ORIGIN}
	}

	@officialAssets path /assets/*
	handle @officialAssets {
		reverse_proxy {$PARTOKENS_API_ORIGIN}
	}

	@officialAdmin path /channels /channels/* /models /models/* /users /users/* /redemption-codes /redemption-codes/* /subscriptions /subscriptions/* /system-info /system-info/* /system-settings /system-settings/*
	handle @officialAdmin {
		reverse_proxy {$PARTOKENS_API_ORIGIN}
	}

	@uiRelease path /_ui/release.json
	handle @uiRelease {
		header Cache-Control "no-store"
		root * {$PARTOKENS_UI_ROOT:/srv/partokens-ui/web}
		file_server
	}

	@publicContent path /public-content/*
	handle @publicContent {
		header Cache-Control "no-store"
		header Content-Type "application/json; charset=utf-8"
		root * {$PARTOKENS_UI_ROOT:/srv/partokens-ui/web}
		file_server
	}

	@uiAssets path /_ui/*
	handle @uiAssets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * {$PARTOKENS_UI_ROOT:/srv/partokens-ui/web}
		file_server
	}

	@webMedia path /brand/* /auth/* /home/*
	handle @webMedia {
		header Cache-Control "public, max-age=3600"
		root * {$PARTOKENS_UI_ROOT:/srv/partokens-ui/web}
		file_server
	}

	@localizedUI path_regexp localizedUI ^/(zh-CN|zh-TW|en|ja|ru|fr|vi)(?:/?|/(?:docs(?:/(?:getting-started/(?:authentication|first-request)|guides/(?:models-and-groups|chat|images|image-studio|usage-logs|errors-and-limits)|api/(?:chat-completions|responses|embeddings|image-generations|image-edits|audio-transcriptions|models)))?|about|notices|status)/?|/legal/(?:user-agreement|service-agreement|privacy-policy)/?|/auth/(?:sign-in|sign-up|verify-email|forgot-password|reset|otp)/?|/console(?:/?|/(?:overview|analytics|keys|usage-logs|wallet|profile|security|connections|notifications)/?|/(?:playground|studio)(?:/[^/]+)?/?)|/console-foundation(?:/?|/(?:overview|analytics|keys|logs)/?)|/console-(?:security|connections|notifications)/?)$
	handle @localizedUI {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://challenges.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' blob: data: https:; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:"
		}
		root * {$PARTOKENS_UI_ROOT:/srv/partokens-ui/web}
		try_files {path} /index.html
		file_server
	}

	@localizedNotFound path_regexp localizedNotFound ^/(zh-CN|zh-TW|en|ja|ru|fr|vi)(/.*)?$
	handle @localizedNotFound {
		error 404
	}

	# Backend reset emails use /user/reset; the Web router canonicalizes it to /{locale}/auth/reset.
	@technicalUI path / /oauth /oauth/* /user/reset
	handle @technicalUI {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://challenges.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' blob: data: https:; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:"
		}
		root * {$PARTOKENS_UI_ROOT:/srv/partokens-ui/web}
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy {$PARTOKENS_API_ORIGIN}
	}

	handle_errors {
		@localizedError {
			expression {err.status_code} == 404
			path_regexp localizedErrorPath ^/(zh-CN|zh-TW|en|ja|ru|fr|vi)(/.*)?$
		}
		handle @localizedError {
			header {
				Cache-Control "no-store"
				Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://challenges.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' blob: data: https:; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:"
				X-Content-Type-Options "nosniff"
				Referrer-Policy "strict-origin-when-cross-origin"
				Permissions-Policy "camera=(), geolocation=(), microphone=()"
				X-Frame-Options "DENY"
				Cross-Origin-Opener-Policy "same-origin"
				Cross-Origin-Resource-Policy "same-origin"
				X-Permitted-Cross-Domain-Policies "none"
				X-Robots-Tag "{$PARTOKENS_ROBOTS_HEADER:all}"
				-Server
			}
			root * {$PARTOKENS_UI_ROOT:/srv/partokens-ui/web}
			rewrite * /index.html
			file_server
		}
	}
}
