# Copy this file to deploy/.env. Do not commit deploy/.env.
COMPOSE_PROJECT_NAME=partokens-ui

# Internal HTTP-only listener. The explicit http:// scheme is required so Caddy
# does not enable automatic HTTPS or redirect requests to HTTPS.
PARTOKENS_SITE_ADDRESS=http://:8080
PARTOKENS_ROBOTS_HEADER=all

# Existing API endpoint as seen from the Web container. The frontend deployment
# only proxies requests to this endpoint; it does not create or manage it.
# Use host.docker.internal for an API published on the same Docker host.
PARTOKENS_API_ORIGIN=http://host.docker.internal:3000

# External Root-only channel administration service. Its own deployment owns
# SQLite and the background-monitoring token; neither belongs in this file.
PARTOKENS_ADMIN_API_ORIGIN=http://host.docker.internal:8081

# Use an immutable tag in production. Change it for every release so rollback is
# a configuration change instead of a rebuild.
PARTOKENS_UI_IMAGE=partokens-ui:2026-08-22.1

# Build provenance. Both values must identify the exact clean commit being built.
# The source URL must be anonymously readable for a public AGPL deployment.
PARTOKENS_SOURCE_COMMIT=<full-40-character-git-commit>
PUBLIC_PARTOKENS_SOURCE_URL=https://github.com/your-org/partokens-ui/tree/<full-40-character-git-commit>

# Internal HTTP listener binding. Do not change the container port (8080) unless
# PARTOKENS_SITE_ADDRESS is changed to the same explicit HTTP port.
PARTOKENS_HTTP_BIND_ADDRESS=0.0.0.0
PARTOKENS_HTTP_PORT=8080
