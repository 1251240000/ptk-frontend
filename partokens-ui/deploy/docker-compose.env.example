# Copy to deploy/.env and replace every <...> value before starting production.
# Keep this file out of version control. Compose reads it with --env-file.

COMPOSE_PROJECT_NAME=partokens

# Public Caddy hostname. Caddy obtains and renews certificates automatically
# when this is a real DNS name and ports 80/443 are reachable from the Internet.
PARTOKENS_SITE_ADDRESS=partokens.com
PARTOKENS_ROBOTS_HEADER=all
# Recommended for public deployments so the UI exposes its corresponding-source
# link. Pin the URL to the full commit that was used to build the image.
# PUBLIC_PARTOKENS_SOURCE_URL=https://github.com/your-org/partokens-ui/tree/<full-git-sha>

# UI image. With the default value, `docker compose build` builds from this
# checkout. In a production host without source code, set this to a CI-built
# image such as ghcr.io/your-org/partokens-ui:2026-08-22 and use `pull`.
PARTOKENS_UI_IMAGE=partokens-ui:local

# Caddy host bindings. Set the address to 127.0.0.1 for a private reverse proxy.
CADDY_HTTP_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_HOST_PORT=80
CADDY_HTTPS_BIND_ADDRESS=0.0.0.0
CADDY_HTTPS_HOST_PORT=443

# New API image and ports. The container port is the port Caddy uses internally;
# the host port is optional administrative access and is loopback-only by default.
NEW_API_IMAGE=calciumion/new-api:v1.0.0-rc.21
NEW_API_CONTAINER_PORT=3000
NEW_API_BIND_ADDRESS=127.0.0.1
NEW_API_HOST_PORT=3000
# The Compose default tracks NEW_API_CONTAINER_PORT. Set this only when the
# upstream is external or uses a different hostname, scheme, or port.
# PARTOKENS_API_ORIGIN=http://new-api:3000
NEW_API_NODE_NAME=partokens-new-api-1

# Database and cache credentials. Use long, unique values in production.
# Keep these values URL-safe (letters, numbers, . _ -) because POSTGRES_PASSWORD
# is embedded in SQL_DSN. A password containing URI-reserved characters must be
# percent-encoded in an explicitly supplied SQL_DSN or REDIS_CONN_STRING.
POSTGRES_USER=newapi
POSTGRES_PASSWORD=<replace-with-a-long-random-postgres-password>
POSTGRES_DB=new_api
REDIS_PASSWORD=<replace-with-a-long-random-redis-password>
SESSION_SECRET=<replace-with-a-long-random-session-secret>
# Optional overrides when a password contains URI-reserved characters.
# SQL_DSN=postgresql://newapi:percent%40encoded@postgres:5432/new_api
# REDIS_CONN_STRING=redis://:percent%40encoded@redis:6379

# Secure refresh cookies must list the exact HTTPS browser origin.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://partokens.com

# Must cover the edge network subnet so New API records the real client address.
EDGE_NETWORK_SUBNET=172.30.0.0/24
TRUSTED_PROXIES=172.30.0.0/24
TZ=Asia/Shanghai
