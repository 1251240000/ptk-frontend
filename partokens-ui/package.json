{
  "name": "partokens-ui",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @partokens/web dev",
    "dev:docs": "bun --filter @partokens/docs dev",
    "build": "bun --filter @partokens/web build && bun --filter @partokens/docs build",
    "typecheck": "bun --filter @partokens/web typecheck && bun --filter @partokens/docs typecheck",
    "test": "bun --filter @partokens/web test && bun --filter @partokens/docs test",
    "test:e2e": "bun --filter @partokens/web test:e2e",
    "docs:generate": "bun --filter @partokens/docs generate",
    "docs:upstream": "bun packages/docs-sync/src/index.ts",
    "docs:upstream:update": "bun packages/docs-sync/src/index.ts --write",
    "compatibility:upstream": "bun scripts/check-new-api.ts",
    "compatibility:upstream:candidate": "bun scripts/check-new-api.ts --candidate",
    "check": "bun run typecheck && bun run test && bun run test:e2e && bun run build && bun run docs:upstream && bun run compatibility:upstream",
    "release:preflight": "bun scripts/release-check.ts environment",
    "release:package": "bun scripts/package-release.ts",
    "release:verify": "bun scripts/release-check.ts package",
    "release:smoke": "bun scripts/smoke-release.ts",
    "release": "bun run release:preflight && bun run check && bun run release:package && bun run release:verify"
  }
}
