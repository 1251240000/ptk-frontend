PARTOKENS_ADMIN_NEW_API_ORIGIN=http://host.docker.internal:3000
PARTOKENS_ADMIN_DATABASE_PATH=/app/data/partokens-admin.sqlite3
# Outside the database volume and repository; a base64-encoded 32-byte AES key.
PARTOKENS_ADMIN_ENCRYPTION_KEY_SOURCE=/etc/partokens/secrets/channel.key
PARTOKENS_ADMIN_ENCRYPTION_KEY_FILE=/run/secrets/channel_encryption_key
# Root Personal Access Token used only by the background read-only monitor.
PARTOKENS_ADMIN_NEW_API_TOKEN=
PARTOKENS_ADMIN_MONITOR_INTERVAL_SECONDS=60
PARTOKENS_ADMIN_LOG_INTERVAL_SECONDS=300
PARTOKENS_ADMIN_REQUEST_TIMEOUT_SECONDS=15
PARTOKENS_ADMIN_SNAPSHOT_RETENTION=1440
